# =============================================================================
# API KEYS & AUTHENTICATION
# =============================================================================
# SECURITY WARNING: Never commit actual API keys to version control!

# Finnhub - Financial data and news API (optional)
# Get your free key at: https://finnhub.io/
FINNHUB_API_TOKEN=your_finnhub_token_here

# Alpha Vantage - Stock data and news sentiment API (optional)
# Get your free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# NewsAPI - News aggregation service (optional)
# Get your free key at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# MarketAux - Alternative news API (optional)
# Get your key at: https://www.marketaux.com/
MARKETAUX_API_KEY=your_marketaux_key_here


# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Connection URI (required)
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017


# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================

# Option 1: Use full Redis URL (recommended - overrides individual settings below)
REDIS_URL=redis://localhost:6379/0

# Option 2: Use individual Redis connection parameters (if REDIS_URL not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Note: If REDIS_URL is set, it takes precedence over REDIS_HOST/PORT/DB/PASSWORD


# =============================================================================
# CACHE TTL (Time To Live) SETTINGS
# =============================================================================
# All values in seconds

# Stock price data cache duration (default: 300 = 5 minutes)
PRICE_CACHE_TTL=300

# News articles cache duration (default: 600 = 10 minutes)
# Note: Timeframe-specific caching is used for progressive fetching:
#   - 1D/1W/1M: 5-10 minutes
#   - 3M: 30 minutes
#   - 6M: 1 hour
#   - YTD: 4 hours
#   - 1Y: 12 hours
#   - 5Y: 24 hours
NEWS_CACHE_TTL=600

# Sentiment analysis results cache duration (default: 900 = 15 minutes)
SENTIMENT_CACHE_TTL=900

# Company information cache duration (default: 86400 = 24 hours)
COMPANY_INFO_CACHE_TTL=86400

# Sector constituent data cache duration (default: 3600 = 1 hour)
SECTOR_CACHE_TTL=3600


# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port (default: 8000)
PORT=8000

# Server host - use 0.0.0.0 to allow external connections
HOST=0.0.0.0

# Debug mode - set to True for development, False for production
DEBUG=False

# Environment identifier: development, production, or staging
ENVIRONMENT=development


# =============================================================================
# AZURE OAUTH CONFIGURATION
# =============================================================================
# For Microsoft Azure AD authentication (all optional)

# Azure Application (Client) ID
APPLICATION_ID=your_azure_app_id

# Azure Directory (Tenant) ID
DIRECTORY_ID=your_azure_tenant_id

# Azure Client Secret (SECURITY WARNING: Keep this secret!)
CLIENT_SECRET=your_azure_client_secret

# Azure Authority URL (default: https://login.microsoftonline.com/common)
AZURE_AUTHORITY=https://login.microsoftonline.com/common

# *** IMPORTANT: OAuth callback redirect URI ***
# Leave blank to auto-generate from API_BASE_URL (recommended)
# Or set explicitly for custom OAuth redirect URLs
# LOCALHOST: http://localhost:8000/auth/callback
# PRODUCTION: https://your-app.azurewebsites.net/auth/callback
AZURE_REDIRECT_URI=

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# These URLs determine whether you're running locally or in production
# The system auto-detects and configures OAuth redirects and CORS accordingly

# *** Frontend URL (where React app is served) ***
# LOCALHOST: http://localhost:3000
# PRODUCTION: https://your-app.azurewebsites.net
FRONTEND_URL=http://localhost:3000

# *** API Base URL (where FastAPI backend is hosted) ***
# LOCALHOST: http://localhost:8000
# PRODUCTION: https://your-app.azurewebsites.net
# NOTE: Also supports legacy variable name "API_BASE" for backward compatibility
API_BASE_URL=http://localhost:8000
# API_BASE=http://localhost:8000  # Alternative (legacy name)

# =============================================================================
# EXAMPLE: LOCALHOST CONFIGURATION (Development)
# =============================================================================
# FRONTEND_URL=http://localhost:3000
# API_BASE_URL=http://localhost:8000
# AZURE_REDIRECT_URI=         (leave blank to auto-generate)
#
# Auto-generated redirect URI: http://localhost:8000/auth/callback

# =============================================================================
# EXAMPLE: AZURE PRODUCTION CONFIGURATION
# =============================================================================
# FRONTEND_URL=https://credit-gtfhduenc9h4a4bp.japanwest-01.azurewebsites.net
# API_BASE_URL=https://credit-gtfhduenc9h4a4bp.japanwest-01.azurewebsites.net
# AZURE_REDIRECT_URI=         (leave blank to auto-generate)
#
# Auto-generated redirect URI: https://credit-gtfhduenc9h4a4bp.japanwest-01.azurewebsites.net/auth/callback


# =============================================================================
# NEWS & DATA INGESTION CONFIGURATION
# =============================================================================

# RSS feed URLs for news ingestion (comma-separated for multiple feeds)
RSS_URLS=https://feeds.reuters.com/reuters/businessNews

# Number of days back to fetch news articles (default: 2)
DAYS_BACK=2

# Progressive News Fetching (Alpha Vantage)
# The system automatically fetches historical news in progressive timeframes:
# - When user requests 1M data, system fetches 1M and queues 6M in background
# - When 6M completes, it queues YTD, then 1Y, then 5Y
# - Rate limiting: 300 API calls per minute (well within Alpha Vantage limits)
# - Batch fetching: Up to 1000 articles per API call with time_from/time_to pagination


# =============================================================================
# SENTIMENT ANALYSIS CONFIGURATION
# =============================================================================

# Exponential decay constant for news recency weighting (default: 0.0289)
# This creates a 24-hour half-life for news relevance
# Formula: RecencyWeight = e^(-k × age_hours)
# - k = 0.0289 means news that is 24 hours old has 50% weight
# - k = 0.0289 means news that is 48 hours old has 25% weight
# - k = 0.0289 means news that is 7 days old has ~4% weight
# Increase k for faster decay (news goes stale quicker)
# Decrease k for slower decay (news stays relevant longer)
SENTIMENT_DECAY_CONSTANT=0.0289


# =============================================================================
# SENTIMENT MOMENTUM CONFIGURATION (MACD-Style Fast vs. Slow)
# =============================================================================

# Sentiment Momentum measures the rate of change of sentiment over time.
# It uses two exponential moving averages (Fast vs. Slow) to detect sentiment shifts.
# Formula: Momentum = FastScore - SlowScore
#
# Interpretation:
#   Positive momentum (+) = News is getting better (bullish trend)
#   Negative momentum (-) = News is getting worse (bearish trend)
#   Near-zero momentum = Sentiment is stable

# Fast Score Half-Life (hours) - Captures current intraday sentiment
# This represents the "current mood" based on very recent news.
# Shorter half-life = more sensitive to breaking news
# Recommended range: 6-12 hours for intraday trading focus
# Formula: k_fast = ln(2) / SENTIMENT_HALF_LIFE_FAST_HOURS
SENTIMENT_HALF_LIFE_FAST_HOURS=7

# Slow Score Half-Life (hours) - Captures daily trend baseline
# This represents the "established trend" over a longer period.
# Longer half-life = smoother, less reactive to single articles
# Recommended range: 24-48 hours for daily trend analysis
# Formula: k_slow = ln(2) / SENTIMENT_HALF_LIFE_SLOW_HOURS
SENTIMENT_HALF_LIFE_SLOW_HOURS=24

# Momentum Classification Thresholds
# NOTE: Momentum thresholds must be smaller than sentiment thresholds because
# momentum is a delta (difference between two scores), not an absolute value.
#
# Weak Momentum Threshold (default: 0.10)
# Momentum >= +0.10 = Weak Positive Momentum (news improving)
# Momentum <= -0.10 = Weak Negative Momentum (news deteriorating)
MOMENTUM_THRESHOLD_WEAK=0.10

# Strong Momentum Threshold (default: 0.20)
# Momentum >= +0.20 = Strong Positive Momentum (news rapidly improving)
# Momentum <= -0.20 = Strong Negative Momentum (news rapidly deteriorating)
MOMENTUM_THRESHOLD_STRONG=0.20


# =============================================================================
# NOTES
# =============================================================================
#
# Required Variables:
#   - MONGO_URI (must be set for database connectivity)
#   - PORT, HOST (server configuration)
#
# Optional Variables:
#   - All API keys are optional; services will be disabled if not provided
#   - Redis configuration is optional; caching will be disabled if not configured
#   - Azure OAuth is optional; authentication will be disabled if not configured
#   - All cache TTL values have sensible defaults
#
# Environment File Loading:
#   - This .env.example file is a template with safe example values
#   - Copy this file to .env and replace with your actual values
#   - The .env file is gitignored and should never be committed
#   - Pydantic BaseSettings loads .env automatically from app/core/config.py
#
# Security Best Practices:
#   - Never commit .env files with real credentials
#   - Use strong, unique passwords for database connections
#   - Rotate API keys and secrets regularly
#   - Use environment-specific configurations for production
#   - Consider using secret management services (AWS Secrets Manager, Azure Key Vault, etc.)
#

# =============================================================================
# API KEYS & AUTHENTICATION
# =============================================================================
# SECURITY WARNING: Never commit actual API keys to version control!

# Finnhub - Financial data and news API (optional)
# Get your free key at: https://finnhub.io/
FINNHUB_API_TOKEN=your_finnhub_token_here

# Alpha Vantage - Stock data and news sentiment API (optional)
# Get your free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# NewsAPI - News aggregation service (optional)
# Get your free key at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# MarketAux - Alternative news API (optional)
# Get your key at: https://www.marketaux.com/
MARKETAUX_API_KEY=your_marketaux_key_here


# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Connection URI (required)
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017


# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================

# Option 1: Use full Redis URL (recommended - overrides individual settings below)
REDIS_URL=redis://localhost:6379/0

# Option 2: Use individual Redis connection parameters (if REDIS_URL not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Note: If REDIS_URL is set, it takes precedence over REDIS_HOST/PORT/DB/PASSWORD


# =============================================================================
# CACHE TTL (Time To Live) SETTINGS
# =============================================================================
# All values in seconds

# Stock price data cache duration (default: 300 = 5 minutes)
PRICE_CACHE_TTL=300

# News articles cache duration (default: 600 = 10 minutes)
NEWS_CACHE_TTL=600

# Sentiment analysis results cache duration (default: 900 = 15 minutes)
SENTIMENT_CACHE_TTL=900

# Company information cache duration (default: 86400 = 24 hours)
COMPANY_INFO_CACHE_TTL=86400

# Sector constituent data cache duration (default: 3600 = 1 hour)
SECTOR_CACHE_TTL=3600


# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port (default: 8000)
PORT=8000

# Server host - use 0.0.0.0 to allow external connections
HOST=0.0.0.0

# Debug mode - set to True for development, False for production
DEBUG=False

# Environment identifier: development, production, or staging
ENVIRONMENT=development


# =============================================================================
# AZURE OAUTH CONFIGURATION
# =============================================================================
# For Microsoft Azure AD authentication (all optional)

# Azure Application (Client) ID
APPLICATION_ID=your_azure_app_id

# Azure Directory (Tenant) ID
DIRECTORY_ID=your_azure_tenant_id

# Azure Client Secret (SECURITY WARNING: Keep this secret!)
CLIENT_SECRET=your_azure_client_secret

# Azure Authority URL (default: https://login.microsoftonline.com/common)
AZURE_AUTHORITY=https://login.microsoftonline.com/common

# OAuth callback redirect URI
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback


# =============================================================================
# NEWS & DATA INGESTION CONFIGURATION
# =============================================================================

# RSS feed URLs for news ingestion (comma-separated for multiple feeds)
RSS_URLS=https://feeds.reuters.com/reuters/businessNews

# Number of days back to fetch news articles (default: 2)
DAYS_BACK=2


# =============================================================================
# FRONTEND & CORS CONFIGURATION
# =============================================================================

# Frontend application URL for CORS configuration
FRONTEND_URL=http://localhost:3000


# =============================================================================
# NOTES
# =============================================================================
#
# Required Variables:
#   - MONGO_URI (must be set for database connectivity)
#   - PORT, HOST (server configuration)
#
# Optional Variables:
#   - All API keys are optional; services will be disabled if not provided
#   - Redis configuration is optional; caching will be disabled if not configured
#   - Azure OAuth is optional; authentication will be disabled if not configured
#   - All cache TTL values have sensible defaults
#
# Environment File Loading:
#   - This .env.example file is a template with safe example values
#   - Copy this file to .env and replace with your actual values
#   - The .env file is gitignored and should never be committed
#   - Pydantic BaseSettings loads .env automatically from app/core/config.py
#
# Security Best Practices:
#   - Never commit .env files with real credentials
#   - Use strong, unique passwords for database connections
#   - Rotate API keys and secrets regularly
#   - Use environment-specific configurations for production
#   - Consider using secret management services (AWS Secrets Manager, Azure Key Vault, etc.)
#

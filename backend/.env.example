# API Keys
FINNHUB_API_TOKEN=your_finnhub_token_here
NEWS_API_KEY=your_news_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
MARKETAUX_API_KEY=your_marketaux_api_key_here

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=False
ENVIRONMENT=development

# News Configuration
RSS_URLS=https://feeds.reuters.com/reuters/businessNews
DAYS_BACK=2

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Azure OAuth

APPLICATION_ID=your_azure_app_id
CLIENT_SECRET=your_azure_client_secret
DIRECTORY_ID=your_directory_id_here
AZURE_AUTHORITY=https://login.microsoftonline.com/common
AZURE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Cache TTL (seconds)
PRICE_CACHE_TTL=300
NEWS_CACHE_TTL=600
SENTIMENT_CACHE_TTL=900
COMPANY_INFO_CACHE_TTL=86400
SECTOR_CACHE_TTL=3600
# =============================================================================
# AZURE PRODUCTION CONFIGURATION
# =============================================================================
# This file is automatically loaded when running `npm run build`
# No need to manually specify it - Create React App handles this automatically
#
# NOTE: After building, you still need to configure Azure App Service
# environment variables for the backend (see backend/.env.example)


# =============================================================================
# API CONFIGURATION (Azure Production)
# =============================================================================

# *** API Base URL ***
# Since frontend and backend are deployed to the same Azure App Service,
# we can use relative paths. The backend serves the React build as static files
# and also handles /api routes.
REACT_APP_API_URL=/api

# *** Backend URL (IGNORED IN PRODUCTION) ***
# This is only used by setupProxy.js which doesn't run in production builds
# Safe to leave as localhost
REACT_APP_BACKEND_URL=http://localhost:8000

# *** WebSocket URL (Azure Production) ***
# IMPORTANT: Update this with your actual Azure App Service URL!
# Use wss:// for secure WebSocket connections
REACT_APP_WS_URL=wss://credit-gtfhduenc9h4a4bp.japanwest-01.azurewebsites.net


# =============================================================================
# PRODUCTION NOTES
# =============================================================================
#
# 1. The setupProxy.js file DOES NOT run in production builds
#    It only works during `npm start` (development)
#
# 2. In production, the React build is served as static files by FastAPI
#    See: backend/app/main.py and GitHub Actions workflow
#
# 3. API requests to /api/* are handled directly by FastAPI routes
#    No proxy is needed since everything is on the same domain
#
# 4. Make sure to configure backend environment variables in Azure:
#    - FRONTEND_URL=https://credit-gtfhduenc9h4a4bp.japanwest-01.azurewebsites.net
#    - API_BASE_URL=https://credit-gtfhduenc9h4a4bp.japanwest-01.azurewebsites.net
#    - AZURE_REDIRECT_URI (leave blank to auto-generate)
#    - APPLICATION_ID, DIRECTORY_ID, CLIENT_SECRET (Azure AD)
#    - MONGO_URI, REDIS_URL (database)
#

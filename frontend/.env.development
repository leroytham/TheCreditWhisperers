# =============================================================================
# LOCALHOST DEVELOPMENT CONFIGURATION
# =============================================================================
# This file is automatically loaded when running `npm start`
# No need to manually specify it - Create React App handles this automatically


# =============================================================================
# API CONFIGURATION (Localhost)
# =============================================================================

# API Base URL - use /api which will be proxied by setupProxy.js
REACT_APP_API_URL=/api

# Backend URL - where setupProxy.js forwards requests (development only)
REACT_APP_BACKEND_URL=http://localhost:8000

# WebSocket URL - for real-time notifications (development)
REACT_APP_WS_URL=ws://localhost:8000


# =============================================================================
# DEVELOPMENT SERVER SETTINGS
# =============================================================================

# Disable host check (needed for some network configurations)
DANGEROUSLY_DISABLE_HOST_CHECK=true

# WebSocket dev server config (for hot module replacement)
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=3000

# Optional: Uncomment to prevent browser from auto-opening
# BROWSER=none

# Optional: Uncomment to use a different port
# PORT=3001

# Environment Variables Template
# Copy this file to .env and update values as needed

# API path prefix for frontend code (used in axios baseURL)
# This should be a relative path to enable proxy routing in development
# Production builds can use this to point to a different API path
REACT_APP_API_URL=/api

# Backend server URL for proxy configuration (used in setupProxy.js)
# This is only used in development by the CRA proxy
# Should be the full URL where your backend server is running
REACT_APP_BACKEND_URL=http://localhost:8000

# WebSocket URL (for real-time notifications)
REACT_APP_WS_URL=ws://localhost:8000

# Disable host check (development only)
DANGEROUSLY_DISABLE_HOST_CHECK=true

# WebSocket dev server configuration
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=3000

# Optional: Browser settings
# BROWSER=none
# PORT=3001

# =============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# =============================================================================
#
# This file is a template. Copy it to create environment-specific files:
#   - .env.development (for localhost - auto-loaded by `npm start`)
#   - .env.production (for Azure - auto-loaded by `npm run build`)
#   - .env.local (for local overrides, gitignored)
#
# IMPORTANT: Only variables prefixed with REACT_APP_ are exposed to the client!
# =============================================================================


# =============================================================================
# API CONFIGURATION
# =============================================================================

# *** API Base URL (where frontend sends requests) ***
# LOCALHOST: /api (proxied by setupProxy.js to http://localhost:8000)
# PRODUCTION: https://your-app.azurewebsites.net/api (or /api if same domain)
REACT_APP_API_URL=/api

# *** Backend server URL (only used by setupProxy.js in development) ***
# This tells the dev server proxy where to forward /api requests
# Only affects `npm start`, not production builds
REACT_APP_BACKEND_URL=http://localhost:8000

# *** WebSocket URL (for real-time notifications) ***
# LOCALHOST: ws://localhost:8000
# PRODUCTION: wss://your-app.azurewebsites.net
REACT_APP_WS_URL=ws://localhost:8000


# =============================================================================
# DEVELOPMENT SERVER CONFIGURATION
# =============================================================================

# Disable host check (development only, needed for some network setups)
DANGEROUSLY_DISABLE_HOST_CHECK=true

# WebSocket dev server configuration (for hot module replacement)
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=3000

# Optional: Browser settings
# BROWSER=none              # Don't auto-open browser
# PORT=3001                 # Use different port


# =============================================================================
# CONFIGURATION EXAMPLES
# =============================================================================

# --- Localhost Development ---
# REACT_APP_API_URL=/api
# REACT_APP_BACKEND_URL=http://localhost:8000
# REACT_APP_WS_URL=ws://localhost:8000
#
# How it works:
#   1. Frontend runs on http://localhost:3000
#   2. Backend runs on http://localhost:8000
#   3. setupProxy.js intercepts /api/* requests
#   4. Forwards to http://localhost:8000 (removes /api prefix)

# --- Azure Production (Same Domain) ---
# REACT_APP_API_URL=/api
# REACT_APP_BACKEND_URL=http://localhost:8000  # Ignored in production
# REACT_APP_WS_URL=wss://credit-gtfhduenc9h4a4bp.japanwest-01.azurewebsites.net
#
# How it works:
#   1. Both frontend and backend deployed to same Azure App Service
#   2. Frontend requests /api/* routes
#   3. Backend handles these routes directly (no proxy needed)

# --- Azure Production (Different Domains) ---
# REACT_APP_API_URL=https://backend-api.azurewebsites.net/api
# REACT_APP_BACKEND_URL=http://localhost:8000  # Ignored in production
# REACT_APP_WS_URL=wss://backend-api.azurewebsites.net
#
# How it works:
#   1. Frontend deployed to one domain
#   2. Backend deployed to another domain
#   3. Frontend makes cross-origin requests to backend
#   4. Backend must have CORS configured to allow frontend domain
